# Vzor souboru .env.local — jen názvy, žádné skutečné hodnoty.
# Skutečný .env.local je na serveru a do gitu nepatří.

# Databáze PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retrokredenc
DB_USER=retrokredenc
DB_PASSWORD=

# Heslo do administrace (/admin)
ADMIN_PASSWORD=

# Kontaktní formulář — Gmail účet a jeho aplikační heslo
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Odkazy na sociální sítě v patičce (volitelné)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
